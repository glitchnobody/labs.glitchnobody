---
import Layout from '../layouts/Layout.astro';
import Block from './Block';
import Modal from './Modal';
import Chips from './Chips.astro';
import { blocks } from '../lab';

/* the wall is every page: / shows it, /slug shows it with that component open */
const { open } = Astro.props;
const list = Object.entries(blocks);
const tags = [...new Set(list.map(([, m]) => m.tag))].sort();
---

<Layout title={open ? `${blocks[open].name} | glitchnobody labs` : undefined} description={open ? blocks[open].description : undefined}>
	<section class="hero">
		<h1>labs</h1>
		<p>Interactive components you can play with right here. Open one to tune its settings and take the code.</p>
	</section>

	<Chips tags={tags} label="Show components by interaction" />

	<main class="wall">
		{list.map(([slug, m]) => (
			<article class="card" data-tag={m.tag} data-shortcut-scope>
				<a class="card-open" href={`/${slug}`} data-block={slug}><span class="card-name">{m.name}</span></a>
				<div class="card-block"><Block slug={slug} client:visible /></div>
				<span class="cursor" aria-hidden="true">
					<svg viewBox="0 0 24 24"><path d="M5 3.2v15.6l4.2-3.9 2.7 6.1 2.8-1.2-2.7-6H18L5 3.2Z" /></svg>
				</span>
				<div class="card-tools">
					{m.demo && (
						<button class="icon" data-play={slug} aria-label={`Play a demo of ${m.name}`}>
							<svg viewBox="0 0 24 24" class="when-idle"><path d="M8 5.5v13l11-6.5-11-6.5Z" fill="currentColor" stroke="none" /></svg>
							<svg viewBox="0 0 24 24" class="when-playing"><rect x="7" y="7" width="10" height="10" rx="1.5" fill="currentColor" stroke="none" /></svg>
						</button>
					)}
					<a class="icon" href={`/${slug}`} data-block={slug} aria-label={`Open ${m.name} settings`}>
						<svg viewBox="0 0 24 24"><path d="M4 8h9m4 0h3M4 16h3m4 0h9" /><circle cx="15" cy="8" r="2" /><circle cx="9" cy="16" r="2" /></svg>
					</a>
				</div>
			</article>
		))}
	</main>

	<Modal client:only="react" />
</Layout>

<script>
	import { blocks } from '../lab';
	import { runDemo } from '../lab/demo';

	const running = new Map<HTMLElement, () => void>();
	document.addEventListener('click', (e) => {
		const button = (e.target as Element).closest<HTMLElement>('[data-play]');
		if (!button) return;
		const card = button.closest<HTMLElement>('.card')!;
		if (running.has(card)) return running.get(card)!();
		/* one demo at a time */
		for (const stop of running.values()) stop();
		const end = () => {
			running.delete(card);
			delete card.dataset.playing;
		};
		card.dataset.playing = '';
		running.set(
			card,
			runDemo(card.querySelector('.card-block')!, card, blocks[button.dataset.play!].demo!, end),
		);
	});

</script>
