---
/* filter chips for a wall: each card carries data-tag, a chip hides the others */
const { tags, label } = Astro.props;
---

<div class="chips" role="group" aria-label={label}>
	<button class="chip" data-chip="" aria-pressed="true">All</button>
	{tags.map((tag: string) => <button class="chip" data-chip={tag} aria-pressed="false">{tag}</button>)}
</div>

<script>
	const chips = [...document.querySelectorAll<HTMLElement>('[data-chip]')];
	for (const chip of chips) {
		chip.addEventListener('click', () => {
			for (const c of chips) c.setAttribute('aria-pressed', String(c === chip));
			for (const card of document.querySelectorAll<HTMLElement>('[data-tag]')) {
				card.hidden = !!chip.dataset.chip && card.dataset.tag !== chip.dataset.chip;
			}
		});
	}
</script>
